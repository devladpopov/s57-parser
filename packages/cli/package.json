{
  "name": "@s57-parser/cli",
  "version": "0.3.0",
  "description": "Command-line tool to inspect S-57/S-101 cells, convert them to GeoJSON and dump ISO 8211 records",
  "license": "MIT",
  "author": "Vladislav Popov <vlad@alumni.york.ac.uk> (https://vladislavpopov.ru)",
  "homepage": "https://github.com/devladpopov/s57-parser/tree/master/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devladpopov/s57-parser.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/devladpopov/s57-parser/issues"
  },
  "keywords": [
    "s-57",
    "iso8211",
    "cli",
    "enc",
    "marine",
    "nautical-chart"
  ],
  "type": "module",
  "bin": {
    "s57": "./dist/index.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "bun test",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@s57-parser/iso8211": "workspace:*",
    "@s57-parser/s101": "workspace:*",
    "@s57-parser/s52-render": "workspace:*",
    "@s57-parser/s57": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.8.0"
  }
}
