{
  "name": "@s57-parser/iso8211",
  "version": "0.3.0",
  "description": "Pure TypeScript ISO 8211 binary format parser",
  "license": "MIT",
  "author": "Vladislav Popov <vlad@alumni.york.ac.uk> (https://vladislavpopov.ru)",
  "homepage": "https://github.com/devladpopov/s57-parser/tree/master/packages/iso8211#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devladpopov/s57-parser.git",
    "directory": "packages/iso8211"
  },
  "bugs": {
    "url": "https://github.com/devladpopov/s57-parser/issues"
  },
  "keywords": [
    "iso8211",
    "iso-8211",
    "parser",
    "binary",
    "ddf",
    "s-57"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "bun test",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
